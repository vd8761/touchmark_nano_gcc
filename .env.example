# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for preview and production. Never commit the filled-in file.

# --- Database -------------------------------------------------------------
# Neon connection string. Use a Neon *branch* for local work, not production.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Signing secret from Resend > Webhooks, for the delivery-tracking endpoint.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# Must be on a domain verified in Resend, or delivery will bounce.
RESEND_FROM_EMAIL="DOS Club <membership@touchmarkdes.com>"

# --- Razorpay -------------------------------------------------------------
# The same account originbi.com uses. Test keys (rzp_test_) until go-live.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# From Razorpay > Settings > Webhooks, on the webhook pointing at
# <this site>/api/webhooks/razorpay. This is what authenticates every payment
# confirmation, so it must not be shared or logged.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- originbi.com handoff -------------------------------------------------
# The cross-domain checkout page. Razorpay's live gateway is approved for
# originbi.com only, so buyers pay there and are returned here.
# /nanogcc/checkout is this site's own route on originbi (mirrors, and is
# independent of, dosmembership's /dosmembership/checkout).
ORIGINBI_CHECKOUT_URL="https://originbi.com/nanogcc/checkout"
# Shared JWT secret. originbi verifies our handoff token with the *identical*
# value - if the two drift, every checkout fails at the door. This is what
# proves the amount was set by our server, so it must never reach the browser.
CROSS_DOMAIN_SECRET="must-match-originbi-exactly"

# --- This site ------------------------------------------------------------
# Signs admin session cookies and salts IP hashes. Rotating it signs everyone out.
SESSION_SECRET="generate-with-openssl-rand-base64-32"
# Bearer token Vercel Cron presents to /api/cron/reconcile.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Absolute origin, no trailing slash. Used in emails and the payment callback.
SITE_URL="https://touchmark-nano-gcc.vercel.app"
# Where internal "new enquiry / new payment" notifications are sent.
ADMIN_NOTIFY_EMAIL="info@touchmarkdes.com"
