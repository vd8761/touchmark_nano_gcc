# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for preview and production. Never commit the filled-in file.

# --- Database -------------------------------------------------------------
# Neon connection string. Use a Neon *branch* for local work, not production.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Signing secret from Resend > Webhooks, for the delivery-tracking endpoint.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# Must be on a domain verified in Resend, or delivery will bounce.
RESEND_FROM_EMAIL="DOS Club <membership@touchmarkdes.com>"

# --- Razorpay -------------------------------------------------------------
# The same account Summit-2026 uses. Test keys (rzp_test_) until go-live.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Same value as RAZORPAY_KEY_ID above, just exposed to the browser too -
# key_id (not key_secret) is meant to be public, it's how /checkout invokes
# the Razorpay widget client-side. NEXT_PUBLIC_ vars are inlined into the
# client bundle at build time, so this must be set wherever the app is built,
# not just at runtime.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# From Razorpay > Settings > Webhooks, on the webhook pointing at
# <this site>/api/webhooks/razorpay. This is what authenticates every payment
# confirmation, so it must not be shared or logged.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Cross-domain checkout handoff -----------------------------------------
# Razorpay's live gateway is not approved for this domain, so Summit-2026
# (vd8761/Summit-2026) creates the Razorpay order on our behalf - but the
# buyer never leaves this site. /checkout is a real page on this domain,
# whose only cross-origin call is a plain CORS-enabled POST to Summit-2026's
# order-creation API (below); no redirect to another domain, no iframe.
ORIGINBI_CHECKOUT_URL="https://nanogcc.touchmarkdes.com/checkout"
# Where /checkout actually creates the order. Not secret, just which account
# creates it, so NEXT_PUBLIC_ (client-exposed) is correct here too.
NEXT_PUBLIC_SUMMIT_GATEWAY_API_URL="https://summitawards2026.executivescollaboration.com/api/create-order-nanogcc"
# Shared JWT secret. Summit-2026 verifies our handoff token with the
# *identical* value - if the two drift, every checkout fails at the door.
# This is what proves the amount was set by our server, so it must never
# reach the browser (unlike the two NEXT_PUBLIC_ vars above).
CROSS_DOMAIN_SECRET="must-match-summit-2026-exactly"

# --- This site ------------------------------------------------------------
# Signs admin session cookies and salts IP hashes. Rotating it signs everyone out.
SESSION_SECRET="generate-with-openssl-rand-base64-32"
# Bearer token Vercel Cron presents to /api/cron/reconcile.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Absolute origin, no trailing slash. Used in emails and the payment callback.
SITE_URL="https://touchmark-nano-gcc.vercel.app"
# Where internal "new enquiry / new payment" notifications are sent.
ADMIN_NOTIFY_EMAIL="info@touchmarkdes.com"
