{
  "name": "touchmark-nano-gcc-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d",
    "local:logs": "docker compose logs -f razorpay-mock resend-mock originbi-mock",
    "local:psql": "docker compose exec postgres psql -U dosclub -d dosclub",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react-signature-canvas": "^1.0.7",
    "ckeditor5": "^48.4.0",
    "gsap": "^3.13.0",
    "html-to-pdfmake": "^2.5.34",
    "jsdom": "^29.1.1",
    "lenis": "^1.1.20",
    "mammoth": "^1.12.1",
    "next": "^15.1.0",
    "node-html-parser": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.1",
    "pdfmake": "^0.3.11",
    "puppeteer": "^25.9.0",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "react-quill-new": "^3.8.3",
    "react-select": "^5.10.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
